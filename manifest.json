{
  "manifest_version": 3,
  "name": "Booking Test Data Ninja",
  "version": "1.0.0",
  "description": "A sleepy ninja that fills the origo-booking 'på vegne av' form with random but valid test data.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.booking-narnia-dev.oslo.systems/*",
        "http://localhost/*"
      ],
      "js": ["data.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
